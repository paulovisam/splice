{
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.rulers": [79]
  },
  "black-formatter.args": [
    "--skip-string-normalization",
    "--line-length", "79"
  ],
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 5000,
  "editor.formatOnSave": true,
}